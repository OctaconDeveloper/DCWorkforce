# Application Port
PORT=3000

# Database Configuration (Prisma)
# 1. SQLite (Default, zero setup):
DATABASE_URL="file:./dev.db"

# 2. PostgreSQL (Optional future setup):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church_workers_db?schema=public"

# 3. MySQL (Optional future setup):
# DATABASE_URL="mysql://root:password@localhost:3306/church_workers_db"

# Authentication & Security
JWT_SECRET=church_workers_management_secret_key_2026
JWT_EXPIRES_IN=7d

# Default Initial Admin Credentials (auto-seeded on first run)
ADMIN_EMAIL=admin@church.com
ADMIN_PASSWORD=admin123
ADMIN_PHONE=2348012345678

# WhatsApp Configuration
# Comma-separated list of admin phone numbers authorized for WhatsApp management commands
ADMIN_PHONE_NUMBERS=2348012345678,2348000000000
AUTH_FOLDER_PATH=./auth_info_baileys

# Telegram Bot Configuration
# Bot token obtained from @BotFather on Telegram (optional - bot is idle if omitted)
TELEGRAM_BOT_TOKEN=8730183999:AAEfX8j7V9vT_d4De41ajPjBKIQZ8181-T8
