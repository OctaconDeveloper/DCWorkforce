    "@types/node": "^20.11.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
