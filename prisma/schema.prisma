// Prisma Schema Configuration
// To switch database provider:
// - SQLite (Default, zero-setup): provider = "sqlite", DATABASE_URL = "file:./dev.db"
// - PostgreSQL: provider = "postgresql", DATABASE_URL = "postgresql://user:pass@localhost:5432/dbname?schema=public"
// - MySQL: provider = "mysql", DATABASE_URL = "mysql://user:pass@localhost:3306/dbname"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Church Admin")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Worker {
  id         String   @id @default(uuid())
  fullName   String
  phone      String   @unique
  department String   @default("media") // choir, ushering, media, protocol, prayer, children, welfare
  unit       String?  // e.g. IT/Livestream, Sound, Camera, Soprano
  role       String   @default("Member")
  email      String?
  birthday          String?  // Stored in YYYY-MM-DD or DD Mon format (e.g. 21 Aug)
  joinedDate        String?  // Stored in YYYY-MM-DD format
  maritalStatus     String?  // Single, Married, etc.
  attendedDLI       String?  // yes / no
  attendedDCA       String?  // yes / no
  attendedEncounter String?  // yes / no
  address           String?  // Full Address
  lid               String?  @unique // WhatsApp Linked Device ID (LID) for modern WhatsApp multi-device
  telegramId        String?  @unique // Telegram Chat/User ID for Telegram Bot
  telegramUsername  String?  // Telegram @username
  isActive          Boolean   @default(true)
  isHOD             Boolean   @default(false)
  isUnitHead        Boolean   @default(false)
  lastInteractedAt  DateTime? // Timestamp of first / latest interaction with bot
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  broadcastGroups   BroadcastGroupMember[]

  @@index([department])
  @@index([isActive])
  @@index([lid])
  @@index([telegramId])
  @@map("workers")
}

model DepartmentUnit {
  id         String   @id @default(uuid())
  department String   // e.g. media, choir, ushering, etc.
  name       String   // e.g. IT/Livestream, Sound, Camera, Soprano
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([department, name])
  @@index([department])
  @@map("department_units")
}

model RegistrationRequest {
  id                String   @id @default(uuid())
  fullName          String
  phone             String
  department        String
  unit              String
  role              String   @default("Member")
  birthday          String?
  maritalStatus     String?
  attendedDLI       String?
  attendedDCA       String?
  attendedEncounter String?
  address           String?
  lid               String?
  telegramId        String?
  status            String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  reviewedBy        String?
  reviewNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([department, status])
  @@index([phone])
  @@map("registration_requests")
}

model Schedule {
  id                String   @id @default(uuid())
  department        String   // choir, ushering, media, protocol, prayer, children, welfare
  title             String
  date              String   // YYYY-MM-DD format
  time              String   // e.g. 08:00 AM
  venue             String
  description       String?
  targetScope       String   @default("DEPARTMENT") // ALL, DEPARTMENT, UNIT, WORKER
  targetUnit        String?  // e.g. IT / Livestream & Broadcast, Sound
  targetWorkers     String?  // Comma-separated list or JSON array of worker phones or names
  createdBy         String?  // Creator name / Admin / HOD
  creatorRole       String?  // ADMIN, HOD, UNIT_HEAD
  reminderSent2Days Boolean  @default(false)
  reminderSent1Day  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([department])
  @@index([date])
  @@index([targetScope])
  @@index([targetUnit])
  @@map("schedules")
}


model Announcement {
  id               String   @id @default(uuid())
  title            String
  message          String
  targetScope      String   @default("ALL") // ALL, DEPARTMENT, UNIT
  targetDepartment String?  // e.g. media, choir, or null if ALL
  targetUnit       String?  // e.g. Sound, Livestream, or null
  createdBy        String?  // Creator name / worker ID / Admin
  creatorRole      String?  // ADMIN, HOD, UNIT_HEAD
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([targetScope])
  @@index([targetDepartment])
  @@index([targetUnit])
  @@map("announcements")
}

model Event {
  id               String   @id @default(uuid())
  title            String
  description      String?
  date             String   // YYYY-MM-DD
  time             String?  // e.g. "08:00 AM", "6:00 PM"
  venue            String?  // e.g. "Main Sanctuary", "Hall B"
  targetScope      String   @default("ALL") // ALL, DEPARTMENT, UNIT
  targetDepartment String?  // e.g. media
  targetUnit       String?  // e.g. IT/Livestream
  createdBy        String?
  creatorRole      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
  @@index([targetScope])
  @@index([targetDepartment])
  @@index([targetUnit])
  @@map("events")
}

model BroadcastGroup {
  id          String                 @id @default(uuid())
  name        String                 @unique // e.g. "youth-leaders", "service-leads"
  description String?
  members     BroadcastGroupMember[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("broadcast_groups")
}

model BroadcastGroupMember {
  id        String         @id @default(uuid())
  groupId   String
  group     BroadcastGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([groupId, workerId])
  @@index([groupId])
  @@index([workerId])
  @@map("broadcast_group_members")
}
